NEXT_PUBLIC_CREATE_HOST=your-domain.example.com
NEXT_PUBLIC_PROJECT_GROUP_ID=
NEXT_PUBLIC_CREATE_ENV=PRODUCTION

# Optional payment providers
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=